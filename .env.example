# PostgreSQL Database Connection Settings
# Option 1: Standard Single Connection String (used by Render, Neon, Supabase, Railway, Heroku)
DATABASE_URL=postgresql://postgres:password@localhost:5433/european_energy

# Option 2: Individual Connection Parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=european_energy

# Streamlit App Configuration
PORT=8501
